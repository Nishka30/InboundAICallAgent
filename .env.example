# Inbound caller service — environment template.
#
# Copy to `.env` and fill in real values locally. `.env` is gitignored; never
# commit real credentials, and never put real secrets in this example file.
# Every provider credential is OPTIONAL at startup: the HTTP server and the
# /health endpoints boot without them. An integration fails loudly (naming the
# missing variable, never its value) only when it is actually used.

# --- Service ---
NODE_ENV=development
PORT=3100
LOG_LEVEL=info
# Comma-separated browser origin allowlist. Empty = no CORS headers (secure
# default for a server-to-server service). "*" is rejected.
CORS_ALLOWED_ORIGINS=

# --- Retell (inbound) ---
# The inbound webhook is signature-verified using the Retell API key (Retell
# signs webhooks with your API key; there is no separate webhook secret).
RETELL_API_BASE_URL=https://api.retellai.com
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_NAME=AI Inbound Caller
RETELL_INBOUND_NUMBER=
RETELL_TIMEOUT_MS=15000
RETELL_WEBHOOK_REPLAY_WINDOW_MS=300000

# --- Guided Boost (separate repo, integrated over HTTP only) ---
# Reuses the existing authenticated CRM surface; sent as X-Lead-API-Key plus the
# X-Agent-Email / X-Agent-Name write identity. Drives the inbound caller APIs
# (identify, inquiries, issues).
GUIDED_BOOST_BASE_URL=https://guided-boost.lovable.app
GUIDED_BOOST_API_KEY=
GUIDED_BOOST_AGENT_EMAIL=inbound-caller@himalayanwonders.com
GUIDED_BOOST_AGENT_NAME=AI Inbound Caller
# DEFAULT / fallback brand sent to Guided Boost (used when the dialed number is not
# in INBOUND_BRAND_NUMBERS). Accepts a brand code (HW, TH, PH, AH) or a domain.
GUIDED_BOOST_BRAND=HW
# Per-number brand mapping: the number the caller DIALED determines the brand.
# Comma-separated <e164>=<brand> pairs. Empty = single-brand mode (GUIDED_BOOST_BRAND).
# Add each brand's inbound number as it is configured. Currently live (four brands):
#   Himalayan Wonders (HW): +12318310814
#   PatagoniaHero (PH):     +12088125606
#   TrekkingHero (TH):      +12086266299
#   AdventureHero (AH):     +17622403272
# e.g. INBOUND_BRAND_NUMBERS=+12318310814=HW,+12088125606=PH,+12086266299=TH,+17622403272=AH
INBOUND_BRAND_NUMBERS=
GUIDED_BOOST_TIMEOUT_MS=10000
GUIDED_BOOST_MAX_RETRIES=3

# --- Persistence (Neon / Postgres) ---
# Optional. Unset = in-memory call store (local dev / tests). Set = durable
# Postgres persistence; migrations run automatically at startup. This is a
# SECRET (it contains the database password) — never commit the real value, and
# the application never logs it. Use the Neon connection string, e.g.
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
